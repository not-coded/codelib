{
  "schemaVersion": 1,
  "id": "codelib",
  "version": "${version}",

  "name": "CodeLib",
  "description": "A Minecraft Fabric API/Library that provides useful features.",
  "entrypoints": {
    "client": [
      "net.notcoded.codelib.client.CodeLibClient"
    ],
    "server": [
      "net.notcoded.codelib.server.CodeLibServer"
    ]
  },
  "authors": [
    "NotCoded"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/codelib",
    "sources": "https://github.com/not-coded/codelib",
    "issues": "https://github.com/not-coded/codelib/issues"
  },

  "license": "GPL-3.0",
  "environment": "*",
  "icon": "assets/codelib/logo.png",
  "mixins": [
    "codelib-server.mixins.json",
    "codelib-client.mixins.json"
  ],

  "depends": {
    "fabricloader": ">=0.13.3",
    "minecraft": "${minecraftVersion}",
    "java": ">=${javaVersion}"
  }
}
